{
  "openapi": "3.0.3",
  "info": {
    "title": "Dynamic Settings API",
    "description": "API for managing dynamic settings with type validation",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "API v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      }
    },
    "schemas": {
      "SettingsValueType": {
        "type": "string",
        "enum": ["str", "int", "float", "bool", "json"],
        "description": "Type of the settings value"
      },
      "CreateSettingsRequest": {
        "type": "object",
        "required": ["key", "value", "type"],
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 1024,
            "description": "Unique key for the setting"
          },
          "value": {
            "type": "string",
            "maxLength": 4194304,
            "description": "Value of the setting (max 4 MiB)"
          },
          "type": {
            "$ref": "#/components/schemas/SettingsValueType"
          }
        }
      },
      "UpdateSettingsRequest": {
        "type": "object",
        "required": ["key", "value"],
        "properties": {
          "key": {
            "type": "string",
            "description": "Key of the setting to update"
          },
          "value": {
            "type": "string",
            "maxLength": 4194304,
            "description": "New value of the setting (max 4 MiB)"
          }
        }
      },
      "DeleteSettingsByKeysRequest": {
        "type": "object",
        "required": ["keys"],
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "Array of keys to delete"
          }
        }
      },
      "ValidateTokenRequest": {
        "type": "object",
        "required": ["token"],
        "properties": {
          "token": {
            "type": "string",
            "description": "Token to validate"
          }
        }
      },
      "SettingsDBRow": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Unique key for the setting"
          },
          "value": {
            "type": "string",
            "description": "Value of the setting"
          },
          "type": {
            "$ref": "#/components/schemas/SettingsValueType"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp"
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Response message"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message"
          }
        }
      }
    }
  },
  "paths": {
    "/settings": {
      "post": {
        "summary": "Create settings",
        "description": "Create a new settings entry with key, value, and type",
        "tags": ["Settings"],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSettingsRequest"
              },
              "example": {
                "key": "app.feature.enabled",
                "value": "true",
                "type": "bool"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Settings created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                },
                "example": {
                  "message": "Settings with key 'app.feature.enabled' created"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing X-Api-Key header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Invalid X-Api-Key header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Settings with this key already exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get all settings",
        "description": "Retrieve all settings, optionally filtered by key prefix",
        "tags": ["Settings"],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter settings by key prefix"
          }
        ],
        "responses": {
          "200": {
            "description": "List of settings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SettingsDBRow"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing X-Api-Key header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Invalid X-Api-Key header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update settings",
        "description": "Update the value of an existing settings entry",
        "tags": ["Settings"],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSettingsRequest"
              },
              "example": {
                "key": "app.feature.enabled",
                "value": "false"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Settings updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                },
                "example": {
                  "message": "Settings updated"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing X-Api-Key header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Invalid X-Api-Key header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Settings with this key not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete settings",
        "description": "Delete settings by providing an array of keys",
        "tags": ["Settings"],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteSettingsByKeysRequest"
              },
              "example": {
                "keys": ["app.feature.enabled", "app.another.setting"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Settings deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                },
                "example": {
                  "message": "Settings deleted"
                }
              }
            }
          },
          "400": {
            "description": "Validation error (empty keys array)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing X-Api-Key header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Invalid X-Api-Key header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/settings/{key}": {
      "get": {
        "summary": "Get settings by key",
        "description": "Retrieve a specific settings entry by its key",
        "tags": ["Settings"],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The key of the setting to retrieve"
          }
        ],
        "responses": {
          "200": {
            "description": "Settings found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsDBRow"
                }
              }
            }
          },
          "401": {
            "description": "Missing X-Api-Key header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Invalid X-Api-Key header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Settings with this key not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/validate-token": {
      "post": {
        "summary": "Validate token",
        "description": "Validate if a token is valid",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateTokenRequest"
              },
              "example": {
                "token": "your-api-key"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token is valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                },
                "example": {
                  "message": "Token is valid"
                }
              }
            }
          },
          "403": {
            "description": "Invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Settings",
      "description": "Settings management operations"
    },
    {
      "name": "Authentication",
      "description": "Authentication operations"
    }
  ]
}
